# ENVIRONMENT
ENV=prod

# Django Settings
SECRET_KEY='<your_secret_key>'
BACKEND_HOST=<your_backend_host>
ALLOWED_HOSTS=<your_allowed_hosts>
CSRF_TRUSTED_ORIGINS=<your_csrf_trusted_origins>
CORS_ALLOWED_ORIGINS=<your_cors_allowed_origins>
CORS_ALLOW_CREDENTIALS=true

# Django Superuser
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Treafik
TRAEFIK_LOG_LEVEL=ERROR
TRAEFIK_DASHBOARD=false
TRAEFIK_INSECURE=false
TRAEFIK_EMAIL=<your_acme_email>

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db_videoflix
DB_USER=user_videoflix
DB_PASSWORD=<your_database_password>
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_MEMORY=256mb

# Gunicorn
# Workers = (vCPU * 2) + 1 → 5 for 2 vCPU
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# Email
EMAIL_HOST=<your_smtp_server_address>
EMAIL_PORT=587
EMAIL_HOST_USER=<your_email>
EMAIL_HOST_PASSWORD=<your_email_password>
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=<your_sender_email>